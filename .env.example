# Contoh konfigurasi. Jangan commit nilai asli.
# - Lokal: `npm run db:init` membuat .env otomatis.
# - Vercel: isi di Project Settings → Environment Variables (lihat docs/07-supabase-vercel.md).

NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Origin yang diizinkan untuk permintaan yang mengubah data (pisahkan dengan koma).
APP_ORIGINS=https://rumah-bintang.vercel.app
# Dipakai untuk tautan aktivasi akun / reset kata sandi.
PUBLIC_BASE_URL=https://rumah-bintang.vercel.app

# Wajib true di produksi (HTTPS).
COOKIE_SECURE=true
TRUST_PROXY=true

SESSION_IDLE_MINUTES=720
SESSION_MAX_DAYS=14

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Role aplikasi rtka_app (tanpa BYPASSRLS, bukan pemilik tabel).
# Supabase di Vercel: TRANSACTION pooler (port 6543), username "rtka_app.<project-ref>".
DATABASE_URL=postgres://rtka_app.PROJECTREF:GANTI@aws-0-REGION.pooler.supabase.com:6543/postgres
# Serverless: pool kecil per instance.
DB_POOL_MAX=3
# Sertifikat CA Supabase (Dashboard → Database → SSL Configuration → Download certificate).
# Isi PEM (baris baru boleh ditulis sebagai \n) atau path berkas. Verifikasi sertifikat tetap aktif.
DB_SSL_CA=
# DB_SSL_CA_FILE=/path/prod-ca-2021.crt

# Role pemilik skema rtka_owner: HANYA untuk migrasi, CLI admin, dan backup dari komputer operator.
# JANGAN diisi di Vercel. Supabase: SESSION pooler (port 5432), username "rtka_owner.<project-ref>".
DATABASE_ADMIN_URL=postgres://rtka_owner.PROJECTREF:GANTI@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Penyimpanan berkas pasien
# ---------------------------------------------------------------------------
# local = disk (pengembangan/VPS); supabase = Supabase Storage (wajib di Vercel).
STORAGE_DRIVER=supabase
SUPABASE_URL=https://PROJECTREF.supabase.co
# Secret key (sb_secret_...) — hanya di server/Vercel, tidak pernah di browser.
SUPABASE_SECRET_KEY=GANTI
SUPABASE_STORAGE_BUCKET=dokumen-pasien
# UPLOAD_DIR=/var/lib/rtka/uploads   # bila STORAGE_DRIVER=local

# ---------------------------------------------------------------------------
# Batas kapasitas (default = paket Supabase Free & batas body Vercel 4,5 MB)
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=4
ORG_STORAGE_QUOTA_MB=450
DB_SIZE_LIMIT_MB=500
STORAGE_LIMIT_MB=1024

# ---------------------------------------------------------------------------
# WhatsApp otomatis (Fonnte) — opsional. Kosong = fitur nonaktif.
# ---------------------------------------------------------------------------
# Kunci enkripsi token Fonnte di database: openssl rand -base64 32
# JANGAN diganti setelah dipakai (token tersimpan tidak bisa dibuka lagi; owner harus memasukkan ulang).
APP_ENCRYPTION_KEY=
# Rahasia penjadwal (min. 32 karakter): openssl rand -hex 32
# Vercel Cron mengirimkannya otomatis sebagai Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Saat build Vercel: jadwal cron. Pro: */10 * * * *  (tiap 10 menit).
# Hobby: kosongkan (Hobby hanya sekali sehari) dan pakai penjadwal eksternal.
CRON_SCHEDULE=
# Jarak antarpesan (detik) dalam satu putaran, agar tidak terkirim beruntun dari satu nomor.
WA_SEND_GAP_SECONDS=10
# FONNTE_API_URL=https://api.fonnte.com
